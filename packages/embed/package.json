{
  "name": "@pydata-app/embed",
  "version": "0.0.1",
  "private": true,
  "description": "Inline React embed of Buckaroo's BuckarooServerView, replacing the iframe path the companion used before.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/buckaroo-embed.tsx --bundle --format=esm --minify --target=es2020 --outdir=../../src/pydata_companion/static --loader:.css=css",
    "watch": "esbuild src/buckaroo-embed.tsx --bundle --format=esm --target=es2020 --outdir=../../src/pydata_companion/static --sourcemap=inline --watch --loader:.css=css"
  },
  "dependencies": {
    "buckaroo-js-core": "0.14.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
